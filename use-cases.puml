@startuml
left to right direction
skinparam packageStyle rectangle

actor "Сотрудник" as employee
actor "Офис-менеджер" as manager
actor "Системный администратор" as admin

rectangle "Система бронирования рабочих мест" {
  usecase "Найти свободное место\n(поиск и фильтрация)" as UC1
  usecase "Забронировать рабочее место" as UC2
  usecase "Изменить / отменить\nсвоё бронирование" as UC3
  usecase "Найти коллегу на карте офиса" as UC4
  usecase "Управлять местами и зонами\n(добавление, редактирование, удаление)" as UC5
  usecase "Изменить статус места\nили оборудования" as UC6
  usecase "Принудительно отменить\nбронирование" as UC7
  usecase "Сформировать отчёт\nо загруженности" as UC8
  usecase "Управлять учётными записями\nи ролями пользователей" as UC9
}

employee --> UC1
employee --> UC2
employee --> UC3
employee --> UC4

manager --> UC5
manager --> UC6
manager --> UC7
manager --> UC8

admin --> UC9

UC2 .> UC1 : include
@enduml
